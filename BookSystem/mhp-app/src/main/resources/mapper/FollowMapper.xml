<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mhp.booksystem.mapper.FollowMapper">

    <resultMap id="MerchantVOMap" type="com.mhp.booksystem.vo.MerchantVO">
        <id     column="id"           property="id"/>
        <result column="user_id"      property="userId"/>
        <result column="nickname"     property="nickname"/>
        <result column="avatar"       property="avatar"/>
        <result column="city"         property="city"/>
        <result column="service_types" property="serviceTypes"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="avg_score"    property="avgScore"/>
        <result column="review_count" property="reviewCount"/>
    </resultMap>

    <select id="selectFollowedMerchants" resultMap="MerchantVOMap">
        SELECT m.id,
               m.user_id,
               u.nickname,
               u.avatar,
               m.city,
               m.service_types,
               m.avg_score,
               m.review_count
        FROM follow f
                 JOIN merchant m ON f.merchant_id = m.id
                 JOIN `user` u ON m.user_id = u.id
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

</mapper>
